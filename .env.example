# Скопировать в .env и заполнить. .env в git не попадает.
#
# Ниже — вариант «наружу через CloudPub»: порты на хосте только локальные, публикует туннель.
# Без CloudPub: убрать COMPOSE_PROFILES, OXYGEN_VIEW_BIND=0.0.0.0, OXYGEN_VIEW_PORT=80, OXYGEN_TRUST_PROXY=0.

# Включает сервис cloudpub из docker-compose.yml
COMPOSE_PROFILES=cloudpub
# Токен агента CloudPub (личный кабинет cloudpub.ru)
CLOUDPUB_TOKEN=
# Что публикует туннель: oxygen:8080 — просмотр. oxygen:8080,oxygen:8081 — и управление; тогда OXYGEN_CONTROL_TOKEN обязателен
CLOUDPUB_HTTP=oxygen:8080

# Токен порта управления (браузер спросит логин/пароль: логин любой, пароль — токен). Пусто — без пароля.
# Если управление публикуется туннелем — длинный случайный, например: openssl rand -hex 24
OXYGEN_CONTROL_TOKEN=

# Просмотр на хосте: 127.0.0.1 — только с самого сервера (снаружи — через туннель); 0.0.0.0 — для всех
OXYGEN_VIEW_BIND=127.0.0.1
OXYGEN_VIEW_PORT=8090
# Управление на хосте: 127.0.0.1 — только с сервера (ssh -L 8081:localhost:8081 ...); 0.0.0.0 — снаружи (тогда обязательно токен)
OXYGEN_CONTROL_BIND=127.0.0.1
OXYGEN_CONTROL_PORT=8081
# 1 — за туннелем адрес зрителя брать из X-Forwarded-For / X-Real-IP (иначе все зрители — один адрес туннеля,
# и лимиты становятся общими). Проверка: https://<адрес туннеля>/api/whoami
OXYGEN_TRUST_PROXY=1

# Аргументы сервера: --resume, --autosave <мин>, --frame-ms <как часто кадр у зрителей, мс>, --brain-limit <раз в сколько секунд зритель может запросить мозг>, --view-rps <запросов/с с адреса>, --load <файл.oxw>, --settings <файл.properties>, --preset, --set имя=значение, --seed
OXYGEN_ARGS=--resume --autosave 10
JAVA_OPTS=-XX:MaxRAMPercentage=75
