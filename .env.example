# Скопировать в .env и заполнить. .env в git не попадает.
# Токен порта управления (браузер спросит логин/пароль: логин любой, пароль — токен). Пусто — без пароля.
OXYGEN_CONTROL_TOKEN=
# Порт просмотра на хосте
OXYGEN_VIEW_PORT=80
# Управление: 127.0.0.1 — только с сервера (ssh -L 8081:localhost:8081 ...); 0.0.0.0 — снаружи (тогда обязательно токен)
OXYGEN_CONTROL_BIND=127.0.0.1
OXYGEN_CONTROL_PORT=8081
# Аргументы сервера: --resume, --autosave <мин>, --frame-ms <как часто кадр у зрителей, мс>, --brain-limit <раз в сколько секунд зритель может запросить мозг>, --load <файл.oxw>, --settings <файл.properties>, --preset, --set имя=значение, --seed
OXYGEN_ARGS=--resume --autosave 10
JAVA_OPTS=-XX:MaxRAMPercentage=75
